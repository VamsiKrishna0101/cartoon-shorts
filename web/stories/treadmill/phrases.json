{
 "duration": 35.318,
 "phrases": [
  {
   "text": "The treadmill was invented to punish criminals.",
   "start": 0.0,
   "end": 2.785
  },
  {
   "text": "England, 1818.",
   "start": 3.295,
   "end": 5.044
  },
  {
   "text": "Engineer William Cubitt saw prisoners sitting around.",
   "start": 5.934,
   "end": 9.012
  },
  {
   "text": "So he built a giant wheel with steps.",
   "start": 9.437,
   "end": 11.889
  },
  {
   "text": "Prisoners climbed it for hours.",
   "start": 12.382,
   "end": 15.028
  },
  {
   "text": "Up, up, up.",
   "start": 15.264,
   "end": 16.211
  },
  {
   "text": "Going nowhere.",
   "start": 16.72,
   "end": 17.764
  },
  {
   "text": "Every day, as high as a mountain.",
   "start": 18.207,
   "end": 20.427
  },
  {
   "text": "Then again tomorrow.",
   "start": 20.875,
   "end": 22.813
  },
  {
   "text": "You see, walking uphill is like carrying groceries upstairs.",
   "start": 23.082,
   "end": 26.182
  },
  {
   "text": "It burns way more than flat walking.",
   "start": 26.53,
   "end": 28.727
  },
  {
   "text": "So put your treadmill on an incline today.",
   "start": 29.177,
   "end": 31.628
  },
  {
   "text": "Prisoners hated it.",
   "start": 32.181,
   "end": 33.376
  },
  {
   "text": "Now we pay for it.",
   "start": 33.707,
   "end": 35.099
  }
 ]
}