{
 "duration": 30.693,
 "phrases": [
  {
   "text": "The first gym bro had no gym.",
   "start": 0.15,
   "end": 2.15
  },
  {
   "text": "Just a baby cow.",
   "start": 2.5,
   "end": 3.643
  },
  {
   "text": "Ancient Greece.",
   "start": 3.993,
   "end": 4.564
  },
  {
   "text": "A wrestler named Milo of Croton.",
   "start": 4.914,
   "end": 6.629
  },
  {
   "text": "Every single day, he picked up a newborn calf and carried it.",
   "start": 6.979,
   "end": 10.507
  },
  {
   "text": "The calf grew.",
   "start": 10.857,
   "end": 11.714
  },
  {
   "text": "Milo grew more.",
   "start": 12.064,
   "end": 12.921
  },
  {
   "text": "Years later, legend says, he walked into the Olympic stadium with a full-grown bull on his shoulders.",
   "start": 13.271,
   "end": 18.329
  },
  {
   "text": "The crowd went wild.",
   "start": 18.679,
   "end": 19.821
  },
  {
   "text": "Then he ate it.",
   "start": 20.171,
   "end": 21.314
  },
  {
   "text": "You see, that's progressive overload.",
   "start": 21.664,
   "end": 23.193
  },
  {
   "text": "Add a little weight every week, and your body keeps up.",
   "start": 23.543,
   "end": 26.786
  },
  {
   "text": "So add one rep today.",
   "start": 27.136,
   "end": 28.564
  },
  {
   "text": "Just maybe skip the cow.",
   "start": 28.914,
   "end": 30.343
  }
 ],
 "estimated": true
}